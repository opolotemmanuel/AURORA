# Neon PostgreSQL (use pooled connection string)
DATABASE_URL=

# better-auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# OAuth (optional — Google works when set; Apple requires all three + flag)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=
NEXT_PUBLIC_APPLE_AUTH_ENABLED=false

# Resend
RESEND_API_KEY=
EMAIL_FROM=Aura <onboarding@resend.dev>

# Tokens & admin bootstrap
SIGNUP_TOKEN_BONUS=10000
BOOTSTRAP_ADMIN_EMAIL=
