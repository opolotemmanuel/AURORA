generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
  OWNER
  SUPPORT
  PRIVACY
}

enum ScanSource {
  CAMERA
  UPLOAD
  UNKNOWN
}

enum ScanStatus {
  RECEIVED
  ANALYZED
  FALLBACK
  FAILED
}

enum ReportSource {
  GEMINI
  FALLBACK
  RULE_BASED
}

enum RoutineStep {
  CLEANSE
  TREAT
  MOISTURIZE
  PROTECT
}

enum MatchStrength {
  PRIMARY
  SUPPORTING
  OPTIONAL
}

enum DownloadFormat {
  PRINT_HTML
  PDF
}

enum AiProviderStatus {
  SUCCESS
  FALLBACK
  FAILED
}

enum ChatMessageRole {
  USER
  ASSISTANT
}

enum DoshaType {
  VATA
  PITTA
  KAPHA
}

enum ScanLedgerReason {
  SIGNUP_BONUS
  SCAN_DEBIT
  ADMIN_GRANT
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified Boolean   @default(false)
  image         String?
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?

  // One-time acknowledgment covering all future cosmetic skin scans on
  // this account — null means not yet given (same "absent means not
  // done" pattern as allergies/doshaProfile below), non-null is the
  // timestamp it was recorded. Given once at signup (or on first /scan
  // visit for an account that predates this field) via
  // app/(onboarding)/onboarding/consent, never re-asked after.
  scanConsentGivenAt DateTime?

  // Free-text, comma/semicolon-separated allergen list the user declares
  // themselves (e.g. "fragrance, lanolin") — parsed by
  // lib/products/match-allergies.ts's parseAllergyTokens. Optional and
  // additive: null means no declared allergies, so
  // filterProductsByAllergies leaves recommendations completely unchanged,
  // same "absent means inert" pattern as DoshaProfile/climate.
  allergies String?

  scans              Scan[]
  reports            Report[]
  downloads          ReportDownload[]
  actedAuditLogs     AuditLog[]          @relation("AuditActor")
  authAccounts       AuthAccount[]
  authSessions       AuthSession[]
  chatMessages       ReportChatMessage[]
  skinAdviceMessages SkinAdviceMessage[]
  doshaProfile       DoshaProfile?
  scanBalance        ScanBalance?
  scanLedgers        ScanLedger[]

  @@index([role])
  @@index([emailVerified])
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuthAccount {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  passwordHash          String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@index([providerId])
}

model AuthVerification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
}

model Scan {
  id                  String     @id @default(cuid())
  userId              String?
  source              ScanSource @default(UNKNOWN)
  status              ScanStatus @default(RECEIVED)
  imageFileName       String?
  imageMimeType       String?
  imageSizeBytes      Int?
  imageWidth          Int?
  imageHeight         Int?
  userAgent           String?
  originalImageStored Boolean    @default(false)
  imageStorageKey     String?
  qualityLighting     String?
  qualityFraming      String?
  qualityConfidence   String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  report Report?

  scanLedgers ScanLedger[]

  @@index([userId])
  @@index([status])
  @@index([source])
  @@index([createdAt])
}

model Report {
  id             String       @id @default(cuid())
  scanId         String       @unique
  userId         String?
  summary        String
  source         ReportSource
  model          String
  disclaimer     String
  fallbackReason String?
  routineTips    Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  scan            Scan                @relation(fields: [scanId], references: [id], onDelete: Cascade)
  user            User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  findings        ReportFinding[]
  recommendations Recommendation[]
  downloads       ReportDownload[]
  aiEvents        AiProviderEvent[]
  chatMessages    ReportChatMessage[]
  climateReading  ClimateReading?

  @@index([userId])
  @@index([source])
  @@index([createdAt])
}

// One weather READING per report, captured once at scan time — same shape
// as lib/climate/adapter.ts's ClimateSnapshot, tied to one already-
// consented, already-completed scan (like ReportFinding/routineTips), not
// ongoing location tracking. Deliberately stores only what the weather WAS,
// never WHERE: no latitude/longitude/city/place-name field exists here or
// anywhere else in this schema, and none should be added — the app's
// per-scan geolocation coordinates are intentionally transient (see
// app/api/scan/analyze/route.ts's parseScanCoordinates) and this model must
// not become a backdoor for persisting them.
model ClimateReading {
  id              String   @id @default(cuid())
  reportId        String   @unique
  temperatureC    Float
  humidityPercent Float
  uvIndex         Float
  createdAt       DateTime @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

// Follow-up chat about one report (see lib/ai/gemini-adapter.ts's
// askAboutReport). `userId` is required (unlike Report.userId) — chat is
// only ever started by a signed-in user who owns the report, never
// anonymously, so there's no optional/SetNull case to support here.
model ReportChatMessage {
  id        String          @id @default(cuid())
  reportId  String
  userId    String
  role      ChatMessageRole
  content   String
  createdAt DateTime        @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([userId])
  @@index([createdAt])
}

// General skin-advice chat — deliberately NOT tied to a report (unlike
// ReportChatMessage above), since this assistant answers general skincare
// questions whether or not the user has a scan yet. Just a userId, no
// reportId, so no report to cascade from — only the user relation cascades.
model SkinAdviceMessage {
  id        String          @id @default(cuid())
  userId    String
  role      ChatMessageRole
  content   String
  createdAt DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// One row per user, updated (not duplicated) on retake — see
// lib/dosha/dosha-store.ts's upsert. Deliberately separate from
// primaryDosha/secondaryDosha rather than one combined enum (e.g.
// "VATA_PITTA"): keeping them as two nullable-secondary CosmeticBand-style
// fields makes matching against Product.doshaTags at recommendation-scoring
// time a simple membership check instead of parsing a combined value, and
// avoids a 9-variant enum for every dual/tridoshic combination.
// `breakdown` holds the full percentage split (Vata/Pitta/Kapha rarely
// resolve to one clean 100% type) for display — see lib/dosha/scoring.ts.
model DoshaProfile {
  id             String     @id @default(cuid())
  userId         String     @unique
  primaryDosha   DoshaType
  secondaryDosha DoshaType?
  breakdown      Json
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([primaryDosha])
}

// One row per user — the free-scan credit balance backing the new
// per-user scan allowance (10 free scans, server-enforced in
// app/api/scan/analyze/route.ts). Deliberately a separate table rather
// than columns on User, same reasoning as DoshaProfile above: it's
// feature-specific, one-row-per-user data, not core identity.
//
// This is INDEPENDENT of the shared Gemini API quota (the provider-side
// daily request cap shared across every user of this app, surfaced as a
// "quota" GeminiFailureKind in lib/ai/gemini-adapter.ts) — that's one
// shared budget across the whole platform; this is each user's own
// allowance against that shared budget. A user can have remaining > 0
// here and still hit a Gemini fallback if the shared quota is already
// exhausted by other users. Never conflate the two in UI copy or logic.
model ScanBalance {
  id              String   @id @default(cuid())
  userId          String   @unique
  remaining       Int      @default(10)
  lifetimeGranted Int      @default(10)
  lifetimeUsed    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Signed-delta audit trail for ScanBalance changes (+10 signup_bonus,
// -1 scan_debit, +N admin_grant) — same spirit as AuditLog, scoped to
// credits specifically, and what powers the dashboard's recent-activity
// feed. relatedScanId is SetNull (not Cascade) so deleting the Scan a
// debit was for never blocks or removes the ledger row itself — same
// "audit trail outlives what it's about" pattern as AuditLog.actor above.
model ScanLedger {
  id            String           @id @default(cuid())
  userId        String
  delta         Int
  reason        ScanLedgerReason
  relatedScanId String?
  createdAt     DateTime         @default(now())

  user        User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  relatedScan Scan? @relation(fields: [relatedScanId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([relatedScanId])
  @@index([createdAt])
}

model ReportFinding {
  id          String   @id @default(cuid())
  reportId    String
  label       String
  concern     String?
  band        String
  observation String
  sortOrder   Int
  createdAt   DateTime @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([band])
}

model Product {
  id               String      @id @default(cuid())
  slug             String      @unique
  name             String
  category         String
  routineStep      RoutineStep
  shortDescription String
  imagePath        String?
  cosmeticBenefits Json
  bestFor          Json
  avoidIf          Json?
  // Traditional Ayurvedic dosha relevance ("vata"/"pitta"/"kapha"), same
  // Json-list convention as bestFor/avoidIf above rather than a native
  // String[] — additive input to recommendation-engine.ts's dosha
  // bonus (lib/dosha/), never required: absent/empty means no dosha-based
  // scoring bonus for this product, existing concern/climate scoring is
  // unaffected either way.
  doshaTags        Json?
  officialUrl      String?
  priority         Int
  active           Boolean     @default(true)
  // Set true only by the WooCommerce ingestion sync (lib/products/ingest/)
  // when it creates a product WooCommerce doesn't give us enough to
  // hand-curate — category/routineStep/priority/cosmeticBenefits/bestFor
  // are placeholders, not real data yet. Cleared manually once someone
  // reviews and fills in the real values via the admin product form.
  needsCuration    Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  recommendations Recommendation[]
  // Real, queryable Product<->Ingredient relation — see Ingredient/
  // ProductIngredient below. Explicit join model (not an implicit Prisma
  // m2m) so scripts/sync-catalog.ts, which writes via raw `pg` (not Prisma
  // Client — see that file's header comment), gets stable, self-documenting
  // productId/ingredientId columns instead of Prisma's auto-generated
  // _IngredientToProduct table with opaque A/B columns.
  ingredients     ProductIngredient[]

  @@index([active])
  @@index([routineStep])
}

model Ingredient {
  id          String   @id @default(cuid())
  // Canonical display name (e.g. "Niacinamide") — what UI chips and
  // parse-inci.ts's matches resolve to, regardless of which alias matched.
  name        String   @unique
  // Alternate names/spellings/INCI variants parse-inci.ts should also
  // recognize (e.g. "Vitamin B3" for Niacinamide). Native String[], not
  // Json — this is always a flat list of strings, never richer structure.
  aliases     String[] @default([])
  // Short, honest, non-medical cosmetic-role description — migrated
  // verbatim from lib/products/ingredients.ts (see scripts/seed-ingredients.ts).
  description String
  // SkinConcern values this ingredient is genuinely associated with (see
  // lib/recommendations/types.ts's SkinConcern union) — additive input to
  // recommendation-engine.ts's ingredient-match bonus. Plain String[]
  // rather than a Prisma enum: SkinConcern is already validated at the TS
  // layer everywhere it's read, and doshaTags above already establishes
  // that this schema doesn't force enum usage on small fixed-vocabulary
  // list fields like this one.
  concerns    String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products ProductIngredient[]
}

// Explicit join, not an implicit Prisma many-to-many — see Product.ingredients'
// comment for why. No per-pairing metadata needed yet beyond createdAt, but
// this leaves room for one (e.g. a `source: "parser" | "manual"` flag) at
// near-zero cost later without another migration shaped like this one.
model ProductIngredient {
  id           String   @id @default(cuid())
  productId    String
  ingredientId String
  createdAt    DateTime @default(now())

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([productId, ingredientId])
  @@index([ingredientId])
}

model Recommendation {
  id               String        @id @default(cuid())
  reportId         String
  productId        String?
  productSlug      String
  productName      String
  productCategory  String
  routineStep      RoutineStep
  shortDescription String
  cosmeticBenefits Json
  rank             Int
  score            Int
  matchStrength    MatchStrength
  reasons          Json
  productSnapshot  Json
  createdAt        DateTime      @default(now())

  report  Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([reportId])
  @@index([productId])
  @@index([rank])
  @@index([productSlug])
}

model ReportDownload {
  id        String         @id @default(cuid())
  reportId  String
  format    DownloadFormat
  userId    String?
  ipHash    String?
  userAgent String?
  createdAt DateTime       @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([reportId])
  @@index([format])
  @@index([createdAt])
}

model AuditLog {
  id         String    @id @default(cuid())
  actorId    String?
  actorRole  UserRole?
  action     String
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime  @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model AiProviderEvent {
  id         String           @id @default(cuid())
  provider   String
  model      String
  status     AiProviderStatus
  scanId     String?
  reportId   String?
  reason     String?
  durationMs Int?
  createdAt  DateTime         @default(now())

  report Report? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([provider])
  @@index([status])
  @@index([createdAt])
  @@index([scanId])
  @@index([reportId])
}
